  "components": {
    "schemas": {
      "Contributor": {
        "type": "object",
        "required": [
          "name",
          "position",
          "communication"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the contributor"
          },
          "name": {
            "type": "string",
            "description": "Name of the contributor"
          },
          "position": {
            "type": "string",
            "description": "Position or role"
          },
          "photo": {
            "type": "string",
            "description": "Optional photo URL"
          },
          "communication": {
            "type": "string",
            "description": "Communication link or details"
          }
        }
      },
      "ContributorInput": {
        "type": "object",
        "required": [
          "name",
          "position",
          "communication"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the contributor"
          },
          "position": {
            "type": "string",
            "description": "Position or role"
          },
          "photo": {
            "type": "string",
            "description": "Optional photo URL"
          },
          "communication": {
            "type": "string",
            "description": "Communication link or details"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Experience": {
        "type": "object",
        "required": [
          "role",
          "orgName",
          "orgLogoUrl",
          "startDate",
          "endDate",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the experience"
          },
          "role": {
            "type": "string",
            "description": "Role or job title"
          },
          "orgName": {
            "type": "string",
            "description": "Name of the organization"
          },
          "orgLogoUrl": {
            "type": "string",
            "description": "URL to the organization's logo"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "description": "Start date of the experience"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "description": "End date of the experience"
          },
          "description": {
            "type": "string",
            "description": "Details of the experience"
          }
        }
      },
      "ExperienceInput": {
        "type": "object",
        "required": [
          "role",
          "orgName",
          "orgLogoUrl",
          "startDate",
          "endDate",
          "description"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Role or job title"
          },
          "orgName": {
            "type": "string",
            "description": "Name of the organization"
          },
          "orgLogoUrl": {
            "type": "string",
            "description": "URL to the organization's logo"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "description": "Start date of the experience"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "description": "End date of the experience"
          },
          "description": {
            "type": "string",
            "description": "Details of the experience"
          }
        }
      },
      "Work": {
        "type": "object",
        "required": [
          "title",
          "quickDoc",
          "photoPrev",
          "creationDate",
          "doc",
          "technologies",
          "contributors",
          "src",
          "numOfImages",
          "images"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the work"
          },
          "title": {
            "type": "string",
            "description": "Title of the work"
          },
          "quickDoc": {
            "type": "string",
            "description": "Short documentation or description"
          },
          "photoPrev": {
            "type": "string",
            "description": "URL for the preview photo"
          },
          "creationDate": {
            "type": "string",
            "description": "Creation date of the work"
          },
          "doc": {
            "type": "string",
            "description": "Full documentation"
          },
          "technologies": {
            "type": "array",
            "description": "List of skills/technologies used",
            "items": {
              "$ref": "../doc/skills.yaml#/components/schemas/Skill"
            }
          },
          "contributors": {
            "type": "array",
            "description": "List of contributors",
            "items": {
              "$ref": "../doc/contributors.yaml#/components/schemas/Contributor"
            }
          },
          "src": {
            "type": "array",
            "description": "Source links",
            "items": {
              "type": "string"
            }
          },
          "numOfImages": {
            "type": "integer",
            "description": "Total number of images"
          },
          "images": {
            "type": "array",
            "description": "URLs for images",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "WorkInput": {
