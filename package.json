{
  "name": "lp-control-panel",
  "version": "1.0.0",
  "description": "My portfolio Back-End APIs",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"nodemon dist/app.js\"",
    "schemas": "npm run schemas:openapi && npm run schemas:types",
    "schemas:openapi": "swagger-jsdoc -d src/doc/definition.yaml src/doc/paths/*.ts \"src/doc/!(definition).yaml\" -o src/schemas/openapi.json",
    "schemas:types": "openapi-typescript src/schemas/openapi.json -o src/schemas/index.d.ts",
    "copyfiles": "copyfiles -u 1 \"src/schemas/*.json\" \"src/doc/**/*.yaml\" \"src/doc/*.yaml\" dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoaiWael/LP-Control-Panel.git"
  },
  "keywords": [],
  "author": ".Loa项目'",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LoaiWael/LP-Control-Panel/issues"
  },
  "homepage": "https://github.com/LoaiWael/LP-Control-Panel#readme",
  "dependencies": {
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "openapi-typescript": "^7.13.0",
    "swagger-jsdoc": "^6.2.8",
    "typescript": "^6.0.3"
  }
}
